{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v2/video/generations": {
      "post": {
        "operationId": "_v2_video_generations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "heygen/avatar-6-turbo"
                    ]
                  },
                  "image_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL of the photo to animate: one person with a clearly visible face. Up to 32 MB. The video keeps its aspect ratio."
                  },
                  "audio_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL of the speech the avatar performs. Allowed formats: MP3, WAV. The video lasts as long as the audio."
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "1080p",
                      "2k"
                    ],
                    "default": "1080p",
                    "description": "Output resolution. The price per second depends on it."
                  },
                  "motion_prompt": {
                    "type": "string",
                    "maxLength": 1200,
                    "description": "Natural-language direction for gestures, expression, posture and camera (max 1200 characters)."
                  },
                  "motion_expressiveness": {
                    "type": "string",
                    "enum": [
                      "default",
                      "less"
                    ],
                    "default": "default",
                    "description": "How much the avatar moves: \"less\" keeps head and body motion calmer. motion_prompt wins where the two overlap."
                  },
                  "webhook_url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri",
                    "description": "A public https address on port 443 or 8443 that gets a signed POST when the job ends. Needs a signing secret: POST /v1/webhooks/secret. On /v1/responses it needs `background: true` and does not work with `store: false`. On /v1/images/generations it runs the generation as a task on the models that support it (the others answer 400 webhook_url_not_supported): the answer is { id, status } and the result is read with GET /v1/images/generations/{id}.",
                    "example": "https://client.example/hooks/aiml"
                  }
                },
                "required": [
                  "model",
                  "image_url",
                  "audio_url"
                ],
                "title": "heygen/avatar-6-turbo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The ID of the generated video.",
                      "example": "60ac7c34-3224-4b14-8e7d-0aa0db708325"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "generating",
                        "completed",
                        "error"
                      ],
                      "description": "The current status of the generation task.",
                      "example": "completed"
                    },
                    "video": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "description": "The URL where the file can be downloaded from.",
                              "example": "https://cdn.aimlapi.com/generations/hedgehog/1759866285599-0cdfb138-c03a-49d4-a601-4f6413e27b15.mp4"
                            }
                          },
                          "required": [
                            "url"
                          ]
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri",
                                "description": "The URL where the file can be downloaded from.",
                                "example": "https://cdn.aimlapi.com/generations/hedgehog/1759866285599-0cdfb138-c03a-49d4-a601-4f6413e27b15.mp4"
                              }
                            },
                            "required": [
                              "url"
                            ]
                          }
                        },
                        {
                          "nullable": true
                        }
                      ]
                    },
                    "error": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "message"
                      ],
                      "description": "Description of the error, if any."
                    },
                    "meta": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "usage": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "credits_used": {
                              "type": "number",
                              "description": "The number of tokens consumed during generation.",
                              "example": 120000
                            },
                            "usd_spent": {
                              "type": "number",
                              "description": "The total amount of money spent by the user in USD.",
                              "example": 0.06
                            }
                          },
                          "required": [
                            "credits_used",
                            "usd_spent"
                          ]
                        }
                      },
                      "description": "Additional details about the generation."
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "cURL",
            "source": "curl --request POST \\\n  --url 'https://api.aimlapi.com/v2/video/generations' \\\n  --header 'Authorization: Bearer <YOUR_AIMLAPI_KEY>' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\"model\": \"heygen/avatar-6-turbo\", \"image_url\": \"<PHOTO_URL>\", \"audio_url\": \"<AUDIO_URL>\"}'"
          },
          {
            "lang": "JavaScript",
            "source": "const response = await fetch('https://api.aimlapi.com/v2/video/generations', {\n  method: 'POST',\n  headers: {\n    'Authorization': 'Bearer <YOUR_AIMLAPI_KEY>',\n    'Content-Type': 'application/json',\n  },\n  body: JSON.stringify({\n  \"model\": \"heygen/avatar-6-turbo\",\n  \"image_url\": \"<PHOTO_URL>\",\n  \"audio_url\": \"<AUDIO_URL>\"\n}),\n});\n\nconsole.log(await response.json());"
          },
          {
            "lang": "Python",
            "source": "import requests\n\nresponse = requests.post(\n    \"https://api.aimlapi.com/v2/video/generations\",\n    headers={\n        \"Authorization\": \"Bearer <YOUR_AIMLAPI_KEY>\",\n        \"Content-Type\": \"application/json\",\n    },\n    json={\"model\": \"heygen/avatar-6-turbo\", \"image_url\": \"<PHOTO_URL>\", \"audio_url\": \"<AUDIO_URL>\"},\n)\n\nprint(response.json())"
          }
        ],
        "x-hideTryItPanel": true
      }
    }
  }
}
