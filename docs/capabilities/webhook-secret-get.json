{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/webhooks/secret": {
      "get": {
        "x-codeSamples": [],
        "operationId": "_v1_webhooks_secret",
        "responses": {
          "200": {
            "description": "The secrets that sign events now. The secrets themselves are never shown again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "secrets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "created_at": {
                            "type": "integer",
                            "description": "Unix time (seconds) when the secret was created."
                          },
                          "retires_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix time (seconds) when the secret stops signing, or `null` for the current one."
                          },
                          "created_by": {
                            "$ref": "#/components/schemas/Actor"
                          }
                        },
                        "required": [
                          "created_at",
                          "retires_at",
                          "created_by"
                        ]
                      }
                    }
                  },
                  "required": [
                    "secrets"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Actor": {
        "type": "object",
        "nullable": true,
        "description": "Who created the secret, or `null` for a secret created before this was recorded.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "session",
              "management_key"
            ],
            "description": "Created from the dashboard or with a management API key."
          },
          "user_id": {
            "type": "string",
            "description": "The user who created it."
          },
          "api_key_id": {
            "type": "string",
            "nullable": true,
            "description": "The management API key used, if any."
          }
        }
      }
    }
  }
}
