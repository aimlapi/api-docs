{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/files": {
      "post": {
        "x-codeSamples": [],
        "operationId": "_v1_files_upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The JSONL file with one request per line, up to 50 MiB. Use a `.jsonl` file name or a JSONL MIME type. For a larger file (up to 200 MiB), use the Uploads flow described on this page."
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "batch"
                    ],
                    "description": "Only `batch` can be uploaded."
                  }
                },
                "required": [
                  "file",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "File": {
        "type": "object",
        "description": "A file of the Batch API.",
        "properties": {
          "id": {
            "type": "string",
            "description": "File ID.",
            "example": "file-3f2b8c1e-7a4d-4e0b-9c55-1d2e3f4a5b6c"
          },
          "object": {
            "type": "string",
            "enum": [
              "file"
            ],
            "description": "Always `file`."
          },
          "bytes": {
            "type": "integer",
            "description": "Size of the file in bytes.",
            "example": 1874
          },
          "created_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the file was created.",
            "example": 1794585600
          },
          "expires_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the file is deleted. Result files (`batch_output`) expire 30 days after they are created; `null` when the file has no expiry.",
            "example": null
          },
          "filename": {
            "type": "string",
            "description": "File name.",
            "example": "requests.jsonl"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "batch",
              "batch_output"
            ],
            "description": "`batch` for an input file you uploaded, `batch_output` for an output or error file of a batch."
          },
          "status": {
            "type": "string",
            "enum": [
              "processed"
            ],
            "description": "Deprecated OpenAI field. Always `processed`."
          },
          "status_details": {
            "nullable": true,
            "description": "Deprecated OpenAI field. Always `null`.",
            "example": null
          }
        },
        "required": [
          "id",
          "object",
          "bytes",
          "created_at",
          "expires_at",
          "filename",
          "purpose",
          "status",
          "status_details"
        ]
      }
    }
  }
}
