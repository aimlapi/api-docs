{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/files/{file_id}/content": {
      "get": {
        "x-codeSamples": [],
        "operationId": "_v1_files_file_id_content",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the file.",
            "example": "<REPLACE_WITH_YOUR_FILE_ID>"
          }
        ],
        "responses": {
          "302": {
            "description": "A redirect to a signed link that serves the file's bytes for 5 minutes. HTTP clients and the OpenAI SDKs follow it on their own; the file itself is JSONL.",
            "headers": {
              "Location": {
                "description": "The signed link to the file. It needs no `Authorization` header and stops working after 5 minutes.",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "description": "Always `no-store`.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
