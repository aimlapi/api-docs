{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/batches/{batch_id}/cancel": {
      "post": {
        "x-codeSamples": [],
        "operationId": "_v1_batches_batch_id_cancel",
        "parameters": [
          {
            "name": "batch_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the batch (starts with `batch_`).",
            "example": "<REPLACE_WITH_YOUR_BATCH_ID>"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "404": {
            "description": "`batch_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "`cancel_failed`: the provider did not accept the cancel. The batch keeps running; try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "type": "object",
        "description": "A batch.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Batch ID. Starts with `batch_`.",
            "example": "batch_V1StGXR8Z5jdHi6BmyT8k"
          },
          "object": {
            "type": "string",
            "enum": [
              "batch"
            ]
          },
          "endpoint": {
            "type": "string",
            "description": "The endpoint every line calls.",
            "example": "/v1/chat/completions"
          },
          "model": {
            "type": "string",
            "description": "The model of the batch, as the lines name it.",
            "example": "anthropic/claude-opus-5-5"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "description": "Why the batch failed, or `null`. Holds the first 100 errors; a line that failed on its own is reported in the error file instead.",
            "properties": {
              "object": {
                "type": "string",
                "enum": [
                  "list"
                ]
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Error code, for example `max_tokens_required` or `insufficient_credits`."
                    },
                    "message": {
                      "type": "string",
                      "description": "What went wrong."
                    },
                    "param": {
                      "type": "string",
                      "nullable": true,
                      "description": "The field the error is about, if any."
                    },
                    "line": {
                      "type": "integer",
                      "nullable": true,
                      "description": "1-based line of the input file, if the error is about one line."
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "param",
                    "line"
                  ]
                }
              }
            }
          },
          "input_file_id": {
            "type": "string",
            "description": "ID of the input file."
          },
          "completion_window": {
            "type": "string",
            "description": "Always `24h`.",
            "example": "24h"
          },
          "status": {
            "type": "string",
            "enum": [
              "validating",
              "in_progress",
              "finalizing",
              "completed",
              "failed",
              "expired",
              "cancelling",
              "cancelled"
            ],
            "description": "Current status of the batch."
          },
          "output_file_id": {
            "type": "string",
            "nullable": true,
            "description": "ID of the file with the successful results, once the batch has ended."
          },
          "error_file_id": {
            "type": "string",
            "nullable": true,
            "description": "ID of the file with the lines that failed, once the batch has ended."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the batch was created.",
            "example": 1794585600
          },
          "in_progress_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the provider accepted the batch."
          },
          "expires_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the 24-hour window ends.",
            "example": 1794672000
          },
          "finalizing_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the results started being collected."
          },
          "completed_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch completed."
          },
          "failed_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch failed."
          },
          "expired_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch expired."
          },
          "cancelling_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the cancellation started."
          },
          "cancelled_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch was cancelled."
          },
          "request_counts": {
            "type": "object",
            "description": "Lines by outcome. Updated while the batch runs.",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Lines in the input file."
              },
              "completed": {
                "type": "integer",
                "description": "Lines that succeeded."
              },
              "failed": {
                "type": "integer",
                "description": "Lines that failed, expired or were cancelled."
              }
            },
            "required": [
              "total",
              "completed",
              "failed"
            ]
          },
          "usage": {
            "type": "object",
            "nullable": true,
            "description": "Tokens of the whole batch, as the provider reported them. `null` until the results are read.",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "input_tokens_details": {
                "type": "object",
                "properties": {
                  "cached_tokens": {
                    "type": "integer"
                  }
                }
              },
              "output_tokens": {
                "type": "integer"
              },
              "output_tokens_details": {
                "type": "object",
                "properties": {
                  "reasoning_tokens": {
                    "type": "integer"
                  }
                }
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "string"
            },
            "description": "The metadata you set when creating the batch."
          }
        },
        "required": [
          "id",
          "object",
          "endpoint",
          "model",
          "errors",
          "input_file_id",
          "completion_window",
          "status",
          "output_file_id",
          "error_file_id",
          "created_at",
          "in_progress_at",
          "expires_at",
          "finalizing_at",
          "completed_at",
          "failed_at",
          "expired_at",
          "cancelling_at",
          "cancelled_at",
          "request_counts",
          "usage",
          "metadata"
        ]
      },
      "Error": {
        "type": "object",
        "description": "OpenAI-style error body.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "What went wrong, in plain words."
              },
              "type": {
                "type": "string",
                "description": "Error class.",
                "enum": [
                  "invalid_request_error",
                  "insufficient_quota",
                  "permission_error",
                  "rate_limit_error",
                  "api_error"
                ]
              },
              "param": {
                "type": "string",
                "nullable": true,
                "description": "The field the error is about, if any."
              },
              "code": {
                "type": "string",
                "description": "Machine-readable code, for example `unsupported_endpoint`."
              }
            },
            "required": [
              "message",
              "type",
              "param",
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
