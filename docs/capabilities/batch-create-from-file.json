{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/batches": {
      "post": {
        "x-codeSamples": [],
        "operationId": "_v1_batches_create_from_file",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Optional. A repeat of the same request with the same key returns the batch the first one created instead of a new one. A different request with a key you already used returns `409 idempotency_key_reused`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input_file_id": {
                    "type": "string",
                    "description": "ID of a file uploaded with `purpose=batch`.",
                    "example": "<REPLACE_WITH_YOUR_FILE_ID>"
                  },
                  "endpoint": {
                    "type": "string",
                    "enum": [
                      "/v1/chat/completions"
                    ],
                    "description": "The endpoint every line calls. Only `/v1/chat/completions` is supported."
                  },
                  "completion_window": {
                    "type": "string",
                    "enum": [
                      "24h"
                    ],
                    "description": "The time the batch has to finish. Only `24h` is supported."
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 512
                    },
                    "maxProperties": 16,
                    "description": "Up to 16 string pairs of your own. Keys are up to 64 characters, values up to 512. Returned on the batch object."
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048,
                    "description": "Optional. A public `https` address (port 443 or 8443, a host name rather than an IP address) that receives a signed `batch.completed`, `batch.failed`, `batch.cancelled` or `batch.expired` event when the batch ends. Your account needs a webhook signing secret first. See the Webhooks page."
                  }
                },
                "required": [
                  "input_file_id",
                  "endpoint",
                  "completion_window"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Batch"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid, for example `unsupported_endpoint`, `invalid_file_purpose`, `empty_file`, `model_not_supported_for_batch` or an invalid first line.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "`api_key_required`: batches are created with an API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`file_not_found`: no such file for this API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`idempotency_key_reused`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "`batch_limit_exceeded`: too many batches in progress. See `Retry-After`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "type": "object",
        "description": "A batch.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Batch ID. Starts with `batch_`.",
            "example": "batch_V1StGXR8Z5jdHi6BmyT8k"
          },
          "object": {
            "type": "string",
            "enum": [
              "batch"
            ]
          },
          "endpoint": {
            "type": "string",
            "description": "The endpoint every line calls.",
            "example": "/v1/chat/completions"
          },
          "model": {
            "type": "string",
            "description": "The model of the batch, as the lines name it.",
            "example": "anthropic/claude-opus-5-5"
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "description": "Why the batch failed, or `null`. Holds the first 100 errors; a line that failed on its own is reported in the error file instead.",
            "properties": {
              "object": {
                "type": "string",
                "enum": [
                  "list"
                ]
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Error code, for example `max_tokens_required` or `insufficient_credits`."
                    },
                    "message": {
                      "type": "string",
                      "description": "What went wrong."
                    },
                    "param": {
                      "type": "string",
                      "nullable": true,
                      "description": "The field the error is about, if any."
                    },
                    "line": {
                      "type": "integer",
                      "nullable": true,
                      "description": "1-based line of the input file, if the error is about one line."
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "param",
                    "line"
                  ]
                }
              }
            }
          },
          "input_file_id": {
            "type": "string",
            "description": "ID of the input file."
          },
          "completion_window": {
            "type": "string",
            "description": "Always `24h`.",
            "example": "24h"
          },
          "status": {
            "type": "string",
            "enum": [
              "validating",
              "in_progress",
              "finalizing",
              "completed",
              "failed",
              "expired",
              "cancelling",
              "cancelled"
            ],
            "description": "Current status of the batch."
          },
          "output_file_id": {
            "type": "string",
            "nullable": true,
            "description": "ID of the file with the successful results, once the batch has ended."
          },
          "error_file_id": {
            "type": "string",
            "nullable": true,
            "description": "ID of the file with the lines that failed, once the batch has ended."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the batch was created.",
            "example": 1794585600
          },
          "in_progress_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the provider accepted the batch."
          },
          "expires_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the 24-hour window ends.",
            "example": 1794672000
          },
          "finalizing_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the results started being collected."
          },
          "completed_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch completed."
          },
          "failed_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch failed."
          },
          "expired_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch expired."
          },
          "cancelling_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the cancellation started."
          },
          "cancelled_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the batch was cancelled."
          },
          "request_counts": {
            "type": "object",
            "description": "Lines by outcome. Updated while the batch runs.",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Lines in the input file."
              },
              "completed": {
                "type": "integer",
                "description": "Lines that succeeded."
              },
              "failed": {
                "type": "integer",
                "description": "Lines that failed, expired or were cancelled."
              }
            },
            "required": [
              "total",
              "completed",
              "failed"
            ]
          },
          "usage": {
            "type": "object",
            "nullable": true,
            "description": "Tokens of the whole batch, as the provider reported them. `null` until the results are read.",
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "input_tokens_details": {
                "type": "object",
                "properties": {
                  "cached_tokens": {
                    "type": "integer"
                  }
                }
              },
              "output_tokens": {
                "type": "integer"
              },
              "output_tokens_details": {
                "type": "object",
                "properties": {
                  "reasoning_tokens": {
                    "type": "integer"
                  }
                }
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "string"
            },
            "description": "The metadata you set when creating the batch."
          }
        },
        "required": [
          "id",
          "object",
          "endpoint",
          "model",
          "errors",
          "input_file_id",
          "completion_window",
          "status",
          "output_file_id",
          "error_file_id",
          "created_at",
          "in_progress_at",
          "expires_at",
          "finalizing_at",
          "completed_at",
          "failed_at",
          "expired_at",
          "cancelling_at",
          "cancelled_at",
          "request_counts",
          "usage",
          "metadata"
        ]
      },
      "Error": {
        "type": "object",
        "description": "OpenAI-style error body.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "What went wrong, in plain words."
              },
              "type": {
                "type": "string",
                "description": "Error class.",
                "enum": [
                  "invalid_request_error",
                  "insufficient_quota",
                  "permission_error",
                  "rate_limit_error",
                  "api_error"
                ]
              },
              "param": {
                "type": "string",
                "nullable": true,
                "description": "The field the error is about, if any."
              },
              "code": {
                "type": "string",
                "description": "Machine-readable code, for example `unsupported_endpoint`."
              }
            },
            "required": [
              "message",
              "type",
              "param",
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
