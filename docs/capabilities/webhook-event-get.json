{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/webhooks/events/{event_id}": {
      "get": {
        "x-codeSamples": [],
        "operationId": "_v1_webhooks_events_event_id",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the event (`evt_` followed by 22 characters).",
            "example": "<REPLACE_WITH_YOUR_EVENT_ID>"
          }
        ],
        "responses": {
          "200": {
            "description": "The event with its attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such event, or one you may not see."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Event ID, the same as the `webhook-id` header.",
            "example": "evt_3YpQx8Kq2LmN5rT7vW9zAb"
          },
          "object": {
            "type": "string",
            "enum": [
              "webhook_event"
            ]
          },
          "type": {
            "type": "string",
            "description": "Event type, for example `video.completed` or `batch.completed`."
          },
          "task_id": {
            "type": "string",
            "description": "ID of the generation, response or batch the event is about."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "delivering",
              "delivered",
              "gone",
              "dead"
            ],
            "description": "`pending`: waiting for its next attempt. `delivering`: an attempt is running. `delivered`: your endpoint answered `2xx`. `gone`: your endpoint answered `410`. `dead`: no more attempts, see `dead_reason`."
          },
          "dead_reason": {
            "type": "string",
            "nullable": true,
            "description": "Why delivery stopped, for example `attempts_exhausted`, `revoked`, `no_signing_secret`, `invalid_url` or `client_backlog`."
          },
          "attempts": {
            "type": "integer",
            "description": "Attempts made so far."
          },
          "url_host": {
            "type": "string",
            "description": "Host name of the address the event goes to."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the event was created."
          },
          "next_attempt_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) of the next attempt, if one is planned."
          },
          "delivered_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the event was delivered."
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "task_id",
          "state",
          "dead_reason",
          "attempts",
          "url_host",
          "created_at",
          "next_attempt_at",
          "delivered_at"
        ]
      },
      "EventDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventSummary"
          },
          {
            "type": "object",
            "properties": {
              "body": {
                "nullable": true,
                "description": "The event exactly as it was sent. `null` after 7 days, or when `body_withheld` is `true`."
              },
              "body_withheld": {
                "type": "boolean",
                "description": "`true` when the event belongs to another member of the workspace: an owner or admin sees it without its body."
              },
              "attempt_log": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "attempt": {
                      "type": "integer",
                      "description": "Attempt number."
                    },
                    "trigger": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "manual"
                      ],
                      "description": "`manual` for an attempt started by a re-send."
                    },
                    "started_at": {
                      "type": "integer",
                      "description": "Unix time (seconds) when the attempt started."
                    },
                    "status_class": {
                      "type": "string",
                      "nullable": true,
                      "enum": [
                        "2xx",
                        "3xx",
                        "4xx",
                        "5xx",
                        null
                      ],
                      "description": "Class of the status your endpoint answered with."
                    },
                    "error_class": {
                      "type": "string",
                      "nullable": true,
                      "enum": [
                        "timeout",
                        "unreachable",
                        null
                      ],
                      "description": "Set when there was no answer."
                    },
                    "duration_seconds": {
                      "type": "number",
                      "description": "How long the attempt took."
                    }
                  },
                  "required": [
                    "attempt",
                    "trigger",
                    "started_at",
                    "status_class",
                    "error_class",
                    "duration_seconds"
                  ]
                }
              }
            },
            "required": [
              "body",
              "body_withheld",
              "attempt_log"
            ]
          }
        ]
      }
    }
  }
}
