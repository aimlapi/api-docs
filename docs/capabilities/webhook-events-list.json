{
  "openapi": "3.0.0",
  "info": {
    "title": "AIML API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.aimlapi.com"
    }
  ],
  "paths": {
    "/v1/webhooks/events": {
      "get": {
        "x-codeSamples": [],
        "operationId": "_v1_webhooks_events",
        "parameters": [
          {
            "name": "task_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Only events of this generation, response or batch."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Only events of this type, for example `batch.completed`."
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "delivering",
                "delivered",
                "gone",
                "dead"
              ]
            },
            "description": "Only events in this state."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Number of events per page."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "The `id` of the last event of the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Events you may see, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventSummary"
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "object",
                    "data",
                    "has_more"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "An invalid query, or an `after` that names no event you can see."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Event ID, the same as the `webhook-id` header.",
            "example": "evt_3YpQx8Kq2LmN5rT7vW9zAb"
          },
          "object": {
            "type": "string",
            "enum": [
              "webhook_event"
            ]
          },
          "type": {
            "type": "string",
            "description": "Event type, for example `video.completed` or `batch.completed`."
          },
          "task_id": {
            "type": "string",
            "description": "ID of the generation, response or batch the event is about."
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "delivering",
              "delivered",
              "gone",
              "dead"
            ],
            "description": "`pending`: waiting for its next attempt. `delivering`: an attempt is running. `delivered`: your endpoint answered `2xx`. `gone`: your endpoint answered `410`. `dead`: no more attempts, see `dead_reason`."
          },
          "dead_reason": {
            "type": "string",
            "nullable": true,
            "description": "Why delivery stopped, for example `attempts_exhausted`, `revoked`, `no_signing_secret`, `invalid_url` or `client_backlog`."
          },
          "attempts": {
            "type": "integer",
            "description": "Attempts made so far."
          },
          "url_host": {
            "type": "string",
            "description": "Host name of the address the event goes to."
          },
          "created_at": {
            "type": "integer",
            "description": "Unix time (seconds) when the event was created."
          },
          "next_attempt_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) of the next attempt, if one is planned."
          },
          "delivered_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix time (seconds) when the event was delivered."
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "task_id",
          "state",
          "dead_reason",
          "attempts",
          "url_host",
          "created_at",
          "next_attempt_at",
          "delivered_at"
        ]
      }
    }
  }
}
